{% if eligibility.status == 'matched' %}
HLA match: supplied {{ eligibility.matched_supplied }} is compatible with required {{ eligibility.matched_required }}.
{% elif eligibility.status == 'insufficient_resolution' %}
HLA unresolved: {{ eligibility.reason }}; supplied {{ eligibility.matched_supplied }},
requirement {{ eligibility.matched_required }}. Current typing resolution or annotations do not establish eligibility.
{% elif eligibility.status == 'excluded' %}
HLA exclusion: supplied {{ eligibility.matched_supplied }} matches excluded {{ eligibility.matched_required }};
this treatment is excluded even when another supplied allele matches an allowed group.
{% if eligibility.source %}[HLA eligibility source]({{ eligibility.source }}).{% endif %}
{% elif eligibility.status == 'mismatched' %}
HLA mismatch: supplied {{ eligibility.supplied | join('/') }} does not match required {{ eligibility.required | join('/') }}.
{% else %}
HLA typing is unavailable{% if agent %} for {{ agent }}{% endif %}; this treatment requires {{ eligibility.required | join('/') }}.
{% endif %}

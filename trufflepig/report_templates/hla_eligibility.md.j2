{% if eligibility.status == 'matched' %}
HLA match: supplied {{ eligibility.matched_supplied | literal }} is compatible with required {{ eligibility.matched_required | literal }}.
{% elif eligibility.status == 'insufficient_resolution' %}
HLA unresolved: {{ eligibility.reason | literal }}; supplied {{ eligibility.matched_supplied | literal }},
requirement {{ eligibility.matched_required | literal }}. Current typing resolution or annotations do not establish eligibility.
{% elif eligibility.status == 'excluded' %}
HLA exclusion: supplied {{ eligibility.matched_supplied | literal }} matches excluded {{ eligibility.matched_required | literal }};
this treatment is excluded even when another supplied allele matches an allowed group.
{% if eligibility.source %}[HLA eligibility source]({{ eligibility.source }}).{% endif %}
{% elif eligibility.status == 'mismatched' %}
HLA mismatch: supplied {{ eligibility.supplied | map('literal') | join('/') }} does not match required {{ eligibility.required | map('literal') | join('/') }}.
{% else %}
HLA typing is unavailable{% if agent %} for {{ agent }}{% endif %}; this treatment requires {{ eligibility.required | map('literal') | join('/') }}.
{% endif %}
